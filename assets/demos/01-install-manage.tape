Output assets/demos/01-install-manage.gif

Set FontSize 15
Set Width 820
Set Height 520
Set Theme "Dracula"
Set Padding 20
Set Framerate 12

Type "rolecraft install rolecraft-sh/skills --yes --dry-run --cursor"
Sleep 200ms
Enter
Sleep 6000ms

Type "clear"
Sleep 100ms
Enter
Sleep 1000ms

Type "rolecraft list"
Sleep 200ms
Enter
Sleep 4000ms

Type "clear"
Sleep 100ms
Enter
Sleep 1000ms

Type "rolecraft check"
Sleep 200ms
Enter
Sleep 5000ms

Type "clear"
Sleep 100ms
Enter
Sleep 1000ms

Type "rolecraft rollback --help"
Sleep 200ms
Enter
Sleep 5000ms
